# ================= 系统通用文件（Linux/Windows/Mac） =================
# Windows 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.swp
*.swo
~*
# Linux/Mac 系统文件
.DS_Store
.idea/
.vscode/!*.code-workspace
*.swp
*.swo
# 系统日志文件
*.log
logs/
**/logs/

# ================= 开发工具/IDE配置文件 =================
# VSCode（保留.code-workspace工作区文件，忽略其他）
.vscode/
!*.code-workspace
# WebStorm/IntelliJ
.idea/
*.iml
*.ipr
*.iws
# Sublime
*.sublime-project
*.sublime-workspace

# ================= 依赖包/构建产物（前端通用） =================
# Node.js 依赖
node_modules/
# 构建产物
dist/
build/
out/
lib/
# 包管理缓存
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
# 环境变量配置文件（敏感信息，绝不提交）
.env
.env.*
!env.example
# TypeScript 编译产物
*.tsbuildinfo
dist-ssr/

# ================= 后端通用（Java/Python/Go） =================
# Java
target/
*.class
*.jar
*.war
*.ear
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
# Go
vendor/
bin/
pkg/

# ================= 其他通用忽略 =================
# 压缩包
*.zip
*.rar
*.7z
*.tar
*.gz
# 临时目录
temp/
**/temp/
# 敏感信息文件
*.key
*.pem
*.crt
*.env
*.config
[user]
    name = Your Name
    email = your.email@example.com
[init]
    defaultBranch = main
[core]
    autocrlf = input
    safecrlf = true
    editor = code --wait
[color]
    ui = true
[alias]
    st = status
    co = checkout
    ci = commit
    br = branch
    cm = commit -m
    pull = pull --rebase
    pushf = push --force-with-lease
    logg = log --oneline --graph --all --decorate
    # 自定义日志格式：显示提交时间、作者、信息
    logd = log --pretty=format:"%h %ad %an: %s" --date=short
[commit]
    # 提交信息规范：至少50个字符
    template = ~/.gitmessage.txt
[pull]
    rebase = true # 所有拉取默认使用rebase